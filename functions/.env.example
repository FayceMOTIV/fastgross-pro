# ============================================
# FACE MEDIA FACTORY - Functions Environment
# ============================================
# Copy to .env and fill in your values

# AI Providers (at least one REQUIRED)
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# Email - Resend (primary)
RESEND_API_KEY=re_your_resend_key_here

# Email - SMTP (fallback)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
EMAIL_FROM=Your Name <your@email.com>

# Serper.dev (prospect search - 2500 free/month)
SERPER_API_KEY=your_serper_key_here

# Email Enrichment (OPTIONAL)
DERRICK_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=

# WhatsApp Evolution API (OPTIONAL)
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=facemedia

# PostGrid API (OPTIONAL)
POSTGRID_API_KEY=
