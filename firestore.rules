rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS - RBAC Multi-tenant v2.0
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Get member document for the current user in an org
    function getMemberData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    // Check if user is a member of the organization
    function isMemberOf(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // Get the role of the current user in an org
    function getRole(orgId) {
      return getMemberData(orgId).role;
    }

    // Check if user has a specific role
    function hasRole(orgId, role) {
      return isMemberOf(orgId) && getRole(orgId) == role;
    }

    // RBAC Role hierarchy: owner > admin > manager > member > viewer
    function isOwnerRole(orgId) {
      return hasRole(orgId, 'owner');
    }

    function isAdminOrAbove(orgId) {
      return isMemberOf(orgId) && getRole(orgId) in ['owner', 'admin'];
    }

    function isManagerOrAbove(orgId) {
      return isMemberOf(orgId) && getRole(orgId) in ['owner', 'admin', 'manager'];
    }

    function isMemberOrAbove(orgId) {
      return isMemberOf(orgId) && getRole(orgId) in ['owner', 'admin', 'manager', 'member'];
    }

    function isViewer(orgId) {
      return hasRole(orgId, 'viewer');
    }

    // Can read (all members can read)
    function canRead(orgId) {
      return isMemberOf(orgId);
    }

    // Can write (member and above, not viewer)
    function canWrite(orgId) {
      return isMemberOrAbove(orgId);
    }

    // Can manage (manager and above)
    function canManage(orgId) {
      return isManagerOrAbove(orgId);
    }

    // Can admin (admin and owner only)
    function canAdmin(orgId) {
      return isAdminOrAbove(orgId);
    }

    // ============================================
    // USERS - Profil utilisateur global
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Soft delete only
    }

    // ============================================
    // ORGANIZATIONS - Multi-tenant Root
    // ============================================
    match /organizations/{orgId} {
      // Any authenticated user can read org they're member of
      allow read: if canRead(orgId);
      // Any authenticated user can create an org
      allow create: if isAuthenticated();
      // Only admin+ can update org settings
      allow update: if canAdmin(orgId);
      // Only owner can delete org
      allow delete: if isOwnerRole(orgId);

      // ------------------------------------------
      // MEMBERS - Team members with roles
      // ------------------------------------------
      match /members/{memberId} {
        // All members can see team
        allow read: if canRead(orgId);
        // Admin+ can invite/manage members
        // Special case: org creator can create their own member doc (bootstrap)
        allow create: if canAdmin(orgId) ||
          (isAuthenticated() &&
           memberId == request.auth.uid &&
           get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid);
        allow update: if canAdmin(orgId);
        // Owner only can remove members (or self-remove)
        allow delete: if isOwnerRole(orgId) || request.auth.uid == memberId;
      }

      // ------------------------------------------
      // INVITATIONS - Pending invites
      // ------------------------------------------
      match /invitations/{inviteId} {
        allow read: if canRead(orgId) || resource.data.email == request.auth.token.email;
        allow create: if canAdmin(orgId);
        allow update: if canAdmin(orgId);
        allow delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // PROSPECTS - Leads/Contacts
      // ------------------------------------------
      match /prospects/{prospectId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);

        // Prospect activities (opens, clicks, replies)
        match /activities/{activityId} {
          allow read: if canRead(orgId);
          allow write: if false; // Only Cloud Functions (webhooks)
        }

        // Prospect notes
        match /notes/{noteId} {
          allow read: if canRead(orgId);
          allow create: if canWrite(orgId);
          allow update: if canWrite(orgId) && resource.data.authorId == request.auth.uid;
          allow delete: if canManage(orgId) || resource.data.authorId == request.auth.uid;
        }
      }

      // ------------------------------------------
      // TEMPLATES - Email/SMS/DM templates
      // ------------------------------------------
      match /templates/{templateId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // SEQUENCES - Multi-channel sequences
      // ------------------------------------------
      match /sequences/{sequenceId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);

        // Sequence steps
        match /steps/{stepId} {
          allow read: if canRead(orgId);
          allow write: if canWrite(orgId);
        }

        // Enrolled prospects in this sequence
        match /enrollments/{enrollmentId} {
          allow read: if canRead(orgId);
          allow write: if canWrite(orgId);
        }
      }

      // ------------------------------------------
      // INTERACTIONS - All channel interactions
      // ------------------------------------------
      match /interactions/{interactionId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if false; // Audit trail
      }

      // ------------------------------------------
      // CHANNELS - Channel configurations
      // ------------------------------------------
      match /channels/{channelId} {
        allow read: if canRead(orgId);
        allow write: if canAdmin(orgId);
      }

      // ------------------------------------------
      // INTEGRATIONS - API keys, webhooks
      // ------------------------------------------
      match /integrations/{integrationId} {
        allow read: if canAdmin(orgId);
        allow write: if canAdmin(orgId);
      }

      // ------------------------------------------
      // SETTINGS - Org-level settings
      // ------------------------------------------
      match /settings/{settingId} {
        allow read: if canRead(orgId);
        allow write: if canAdmin(orgId);
      }

      // ------------------------------------------
      // ANALYTICS - Aggregated stats
      // ------------------------------------------
      match /analytics/{docId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // BLACKLIST - RGPD opt-outs
      // ------------------------------------------
      match /blacklist/{email} {
        // Authenticated users can add to blacklist (unsubscribe via Cloud Functions uses Admin SDK)
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['email', 'reason', 'addedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() < 255;
        allow read: if canRead(orgId);
        allow update, delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // AUDIT LOG - Activity log
      // ------------------------------------------
      match /auditLog/{logId} {
        allow read: if canAdmin(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CAMPAIGNS - Legacy support
      // ------------------------------------------
      match /campaigns/{campaignId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // EMAIL ACCOUNTS - Connected email accounts
      // ------------------------------------------
      match /emailAccounts/{accountId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // DOMAIN CONTACTS - Anti-spam cooldown
      // ------------------------------------------
      match /domainContacts/{domain} {
        allow read: if canRead(orgId);
        allow write: if canWrite(orgId);
      }

      // ------------------------------------------
      // WEBHOOK EVENTS - Incoming webhook data
      // ------------------------------------------
      match /webhookEvents/{eventId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // COMPLIANCE AUDIT - RGPD audit trail
      // ------------------------------------------
      match /complianceAudit/{auditId} {
        allow read: if canAdmin(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CHANNEL ANALYTICS - Per-channel stats
      // ------------------------------------------
      match /channelAnalytics/{dateId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CHANNEL TEMPLATES - SMS, WhatsApp, etc.
      // ------------------------------------------
      match /channelTemplates/{templateId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // VOICE CLONES - Voicemail AI voices
      // ------------------------------------------
      match /voiceClones/{voiceId} {
        allow read: if canRead(orgId);
        allow create: if canAdmin(orgId);
        allow update: if canAdmin(orgId);
        allow delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // POSTAL TEMPLATES - Mail piece designs
      // ------------------------------------------
      match /postalTemplates/{templateId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // WHATSAPP SESSIONS - 24h window tracking
      // ------------------------------------------
      match /whatsappSessions/{sessionId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // INSTAGRAM INTERACTIONS - DM tracking
      // ------------------------------------------
      match /instagramInteractions/{interactionId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // INSTAGRAM ACCOUNTS - Multi-account DM sending
      // ------------------------------------------
      match /instagramAccounts/{accountId} {
        allow read: if canRead(orgId);
        allow create: if canAdmin(orgId);
        allow update: if canAdmin(orgId);
        allow delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // WHATSAPP INSTANCES - Multi-instance rotation
      // ------------------------------------------
      match /whatsappInstances/{instanceId} {
        allow read: if canRead(orgId);
        allow create: if canAdmin(orgId);
        allow update: if canAdmin(orgId);
        allow delete: if canAdmin(orgId);

        match /usage/{dateId} {
          allow read: if canRead(orgId);
          allow write: if false; // Only Cloud Functions
        }
      }

      // ------------------------------------------
      // EMAIL SEQUENCES - Multi-step email automation
      // ------------------------------------------
      match /emailSequences/{sequenceId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // EMAIL CAMPAIGNS - Prospect email sequences
      // ------------------------------------------
      match /emailCampaigns/{campaignId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // NOTIFICATIONS - User notifications
      // ------------------------------------------
      match /notifications/{notificationId} {
        allow read: if canRead(orgId);
        allow create: if false; // Only Cloud Functions
        allow update: if canWrite(orgId); // Mark as read
        allow delete: if canWrite(orgId);
      }

      // ------------------------------------------
      // AUTOPILOT CONFIG - Autopilot settings
      // ------------------------------------------
      match /autoPilotConfig/{configId} {
        allow read: if canRead(orgId);
        allow write: if canAdmin(orgId);
      }
      match /autopilotConfig/{configId} {
        allow read: if canRead(orgId);
        allow write: if canAdmin(orgId);
      }

      // ------------------------------------------
      // VOICE CALLS - Org-level voice call records
      // ------------------------------------------
      match /voiceCalls/{callId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // AUTOPILOT LOGS - Autopilot execution logs
      // ------------------------------------------
      match /autoPilotLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ALERTS - System alerts
      // ------------------------------------------
      match /alerts/{alertId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CHANNEL ALERTS - Per-channel alerts
      // ------------------------------------------
      match /channelAlerts/{alertId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CONVERSATIONS - Chat/messaging threads
      // ------------------------------------------
      match /conversations/{conversationId} {
        allow read: if canRead(orgId);
        allow write: if canWrite(orgId);
      }

      // ------------------------------------------
      // DISPATCH LOG - Multi-channel dispatch history
      // ------------------------------------------
      match /dispatchLog/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // FALLBACK LOGS - Channel fallback tracking
      // ------------------------------------------
      match /fallbackLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // HUNTING CAMPAIGNS - Lead hunting campaigns
      // ------------------------------------------
      match /huntingCampaigns/{campaignId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // INSTAGRAM TRIGGERS - Auto-reply triggers
      // ------------------------------------------
      match /instagramTriggers/{triggerId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // INSTAGRAM TRIGGER LOGS - Trigger execution logs
      // ------------------------------------------
      match /instagramTriggerLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // MEETINGS - Scheduled meetings
      // ------------------------------------------
      match /meetings/{meetingId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // POSTAL PURLs - Personal URLs for postal
      // ------------------------------------------
      match /postalPURLs/{purlId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // POSTAL TRACKING - Postal delivery tracking
      // ------------------------------------------
      match /postalTracking/{trackingId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // RATE LIMITS - Channel rate limit tracking
      // ------------------------------------------
      match /rateLimits/{limitId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // SCANS - Website scan results (org-level)
      // ------------------------------------------
      match /scans/{scanId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // TOUCHPOINT HISTORY - Prospect contact history
      // ------------------------------------------
      match /touchpointHistory/{touchpointId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // VOICEMAIL SCRIPTS - Custom voicemail templates
      // ------------------------------------------
      match /voicemailScripts/{scriptId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // WHATSAPP AVAILABILITY - Sending window tracking
      // ------------------------------------------
      match /whatsappAvailability/{availId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ADDRESS VALIDATION CACHE - Postal address cache
      // ------------------------------------------
      match /addressValidationCache/{cacheId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // EMAIL EVENTS - Email delivery events (org-level)
      // ------------------------------------------
      match /emailEvents/{eventId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // CHANNEL ACCOUNTS - LinkedIn, etc. managed by admin
      // ------------------------------------------
      match /channelAccounts/{accountId} {
        allow read: if canRead(orgId);
        allow write: if canAdmin(orgId);
      }

      // ------------------------------------------
      // OUTREACH CAMPAIGNS - Orchestrator campaigns
      // ------------------------------------------
      match /outreachCampaigns/{campaignId} {
        allow read: if canRead(orgId);
        allow create, update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // DAILY BUDGETS - Budget + usage per day
      // ------------------------------------------
      match /dailyBudgets/{date} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ORCHESTRATOR LOGS - Scheduler execution logs
      // ------------------------------------------
      match /orchestratorLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ORCHESTRATOR STATE - Current orchestrator state
      // ------------------------------------------
      match /orchestratorState/{docId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // REPLY FEEDS - Classified reply feed
      // ------------------------------------------
      match /replyFeeds/{replyId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // HOT QUEUE - Real-time hot lead queue (Module 5)
      // ------------------------------------------
      match /hotQueue/{prospectId} {
        allow read: if canRead(orgId);
        allow write: if canWrite(orgId);
      }

      // ------------------------------------------
      // KNOWLEDGE BASE - RAG vector chunks
      // ------------------------------------------
      match /kb/{chunkId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // ESCALATIONS - Human In The Loop queue
      // ------------------------------------------
      match /escalations/{escId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if false; // Audit trail
      }

      // ------------------------------------------
      // AGENT PLAYBOOK - AI learned strategies
      // ------------------------------------------
      match /agentPlaybook/{docId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions (agentLearning)
      }

      // ------------------------------------------
      // SCHEDULED FOLLOWUPS - Delayed tasks
      // ------------------------------------------
      match /scheduledFollowups/{followupId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // REPLY LOGS - Detailed reply processing logs
      // ------------------------------------------
      match /replyLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // SUPPRESSION - Email/channel suppression list
      // ------------------------------------------
      match /suppression/{docId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // HUNTER RESULTS - Sourcing results (Google Maps, LinkedIn, etc.)
      // ------------------------------------------
      match /hunterResults/{resultId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // HUNTER STATS - Sourcing statistics per platform
      // ------------------------------------------
      match /hunterStats/{statId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // DM STATS - Instagram DM daily statistics
      // ------------------------------------------
      match /dmStats/{dateId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // WHATSAPP STATS - Org-level WhatsApp daily stats
      // ------------------------------------------
      match /whatsappStats/{dateId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // INBOXES - Email sending inboxes
      // ------------------------------------------
      match /inboxes/{inboxId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canAdmin(orgId);
      }

      // ------------------------------------------
      // AB TESTS - A/B testing experiments
      // ------------------------------------------
      match /abTests/{testId} {
        allow read: if canRead(orgId);
        allow create: if canWrite(orgId);
        allow update: if canWrite(orgId);
        allow delete: if canManage(orgId);
      }

      // ------------------------------------------
      // PIPELINE - Qualified leads pipeline (Alex Voice + other sources)
      // ------------------------------------------
      match /pipeline/{pipeId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ALEX CONVERSATIONS - Chat history
      // ------------------------------------------
      match /alexConversations/{msgId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ALEX THREADS - Conversation threads
      // ------------------------------------------
      match /alexThreads/{threadId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ALEX MEMORY - KPIs, preferences, strategy
      // ------------------------------------------
      match /alexMemory/{docId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }

      // ------------------------------------------
      // ALEX ACTION LOGS - Audit trail
      // ------------------------------------------
      match /alexActionLogs/{logId} {
        allow read: if canRead(orgId);
        allow write: if false; // Only Cloud Functions
      }
    }

    // ============================================
    // GLOBAL UNSUBSCRIBE - Cross-org RGPD
    // ============================================
    match /globalBlacklist/{email} {
      allow create: if true; // Anyone can unsubscribe
      allow read: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    // ============================================
    // SYSTEM CONFIG - App-wide settings
    // ============================================
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via console
    }

    // ============================================
    // SUBSCRIPTION PLANS - Pricing tiers
    // ============================================
    match /subscriptionPlans/{planId} {
      allow read: if true; // Public for pricing page
      allow write: if isSuperAdmin(); // Only super admins
    }

    // ============================================
    // WHATSAPP STATS - Daily sending statistics
    // ============================================
    match /whatsappStats/{dateId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // SUPER ADMINS - Platform administrators
    // ============================================
    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    match /superAdmins/{userId} {
      // Super admins can read list
      allow read: if isSuperAdmin() || isOwner(userId);
      // Only Cloud Functions can write (autoSuperAdmin)
      allow write: if false;
    }

    // ============================================
    // BETA USERS - Unlimited quota users
    // ============================================
    match /betaUsers/{userId} {
      // Super admins can read/write beta users
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // INTENT HUNTER — Intent leads Pro (B2B)
    // ============================================
    match /intentLeadsPro/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // INTENT HUNTER — Intent leads Particuliers (B2C)
    // ============================================
    match /intentLeadsParticuliers/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // INTENT HUNTER — Pixel visits
    // ============================================
    match /pixelVisits/{visitId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // INTENT HUNTER — Email Domains (reputation)
    // ============================================
    match /emailDomains/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // INTENT HUNTER — Referral leads
    // ============================================
    match /referralLeads/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // INTENT HUNTER — Prospect Memory (SP4)
    // ============================================
    match /prospectMemory/{leadId} {
      allow read: if false;  // Only Cloud Functions
      allow write: if false;
    }

    // ============================================
    // BOUNCES - Email bounce tracking
    // ============================================
    match /bounces/{bounceId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions (SES webhooks)
    }

    // ============================================
    // COMPLAINTS - Email complaint tracking
    // ============================================
    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions (SES webhooks)
    }

    // ============================================
    // CSE CACHE - Custom Search Engine cache
    // ============================================
    match /cse_cache/{cacheId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // EMAIL EVENTS - Global email delivery events
    // ============================================
    match /emailEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // EMAIL LOGS - Email sending logs
    // ============================================
    match /email_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // EMAIL TEST LOGS - Test email logs
    // ============================================
    match /emailTestLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // LEADS - Legacy leads collection (org-scoped via orgId field)
    // ============================================
    match /leads/{leadId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow create: if isAuthenticated()
        && request.resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/members/$(request.auth.uid));
      allow update: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow delete: if false;
    }

    // ============================================
    // ORPHANED WEBHOOKS - Unmatched webhook events
    // ============================================
    match /orphanedWebhooks/{webhookId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // REPORTS - Generated reports
    // ============================================
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // SCANS - Global website scan results (org-scoped via organizationId field)
    // ============================================
    match /scans/{scanId} {
      allow read: if isAuthenticated()
        && resource.data.organizationId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/members/$(request.auth.uid));
      allow create: if isAuthenticated()
        && request.resource.data.organizationId != null
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(request.auth.uid));
      allow update: if isAuthenticated()
        && resource.data.organizationId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/members/$(request.auth.uid));
      allow delete: if false;
    }

    // ============================================
    // UNKNOWN OPT-OUTS - Unmatched unsubscribes
    // ============================================
    match /unknownOptOuts/{optOutId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // CLIENTS - Legacy client collection (org-scoped via orgId field)
    // ============================================
    match /clients/{clientId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow create: if isAuthenticated()
        && request.resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/members/$(request.auth.uid));
      allow update: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow delete: if false;
    }

    // ============================================
    // VOICE CALLS - Alex Voice call records (org-scoped via orgId field)
    // ============================================
    match /voiceCalls/{callId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // SCHEDULED CALLS - Voice call scheduling (org-scoped via orgId field)
    // ============================================
    match /scheduledCalls/{schedId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // SCANNER — Scan results & signals (Cloud Functions only)
    // ============================================
    match /scanResults/{resultId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /scanSignals/{signalId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /scanCache/{cacheId} {
      allow read, write: if false;
    }

    match /tenantQuotas/{orgId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /scanNotifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /scanErrors/{errorId} {
      allow read, write: if false;
    }

    match /scanReports/{reportId} {
      allow read: if false;
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
      match /shards/{shardId} {
        allow read, write: if false;
      }
    }

    // ============================================
    // SOCIAL OMNISCIENT v2 — Signals & Leads
    // ============================================
    // ============================================
    // WHATSAPP USER MAPPINGS - Alex WhatsApp link
    // ============================================
    match /whatsappUserMappings/{phone} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // WHATSAPP VERIFICATIONS - Code verification
    // ============================================
    match /whatsappVerifications/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Only Cloud Functions
    }

    match /socialSignals/{signalId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow write: if false; // Cloud Functions uniquement
    }

    match /socialLeads/{leadId} {
      allow read: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid));
      allow update: if isAuthenticated()
        && resource.data.orgId != null
        && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt', 'sequence']);
      allow create, delete: if false;
    }
  }
}
