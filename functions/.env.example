# ============================================
# FACE MEDIA FACTORY - Functions Environment
# ============================================
# Copy to .env and fill in your values
# Firebase Functions v2 auto-loads .env from functions/ directory
# All vars accessed via process.env (no dotenv, no functions.config)

# ─── AI Providers (at least one REQUIRED) ──────────────────────
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ─── Email - Amazon SES (primary) ────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=Face Media Factory <noreply@facemedia.app>

# ─── Email - SMTP (fallback) ──────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
EMAIL_FROM=Your Name <your@email.com>
EMAIL_ENCRYPTION_KEY=

# ─── Email - OAuth (Google / Microsoft) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── SMS - OVH Telecom ────────────────────────────────────────
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE_NAME=
OVH_SMS_SENDER=FaceMedia

# ─── SMS - BudgetSMS (alternative) ───────────────────────────
BUDGETSMS_USERNAME=
BUDGETSMS_HANDLE=
BUDGETSMS_SENDER=FaceMedia

# ─── WhatsApp - Meta Cloud API ────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── WhatsApp - Evolution API (self-hosted) ───────────────────
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=facemedia

# ─── Instagram - Meta Graph API ───────────────────────────────
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ENCRYPTION_KEY=
META_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
DEFAULT_ORG_ID=

# ─── Instagram - Direct login (hunters) ───────────────────────
IG_USERNAME=
IG_PASSWORD=
IG_PROXY_URL=

# ─── LinkedIn - HeyReach API (NEW - Phase 5) ─────────────────
HEYREACH_API_KEY=

# ─── Scraping - Apify (NEW - Phase 5+6) ──────────────────────
APIFY_API_TOKEN=

# ─── Scraping - Serper.dev (2500 free/month) ──────────────────
SERPER_API_KEY=your_serper_key_here

# ─── Voicemail - Drop Cowboy ──────────────────────────────────
DROPCOWBOY_API_KEY=
DROPCOWBOY_TEAM_ID=
DROPCOWBOY_SECRET=
DROPCOWBOY_BRAND_ID=
DROPCOWBOY_CALLER_ID=
DROPCOWBOY_WEBHOOK_SECRET=

# ─── Postal - PostGrid ───────────────────────────────────────
POSTGRID_API_KEY=
POSTGRID_TEST_MODE=true

# ─── Postal - Merci Facteur ──────────────────────────────────
MERCI_FACTEUR_API_KEY=
MERCI_FACTEUR_SECRET_KEY=
MERCI_FACTEUR_WEBHOOK_SECRET=

# ─── Postal - Tracking ───────────────────────────────────────
PURL_BASE_URL=https://facemediafactory.com/go
DEFAULT_REDIRECT_URL=https://facemediafactory.com

# ─── Email Enrichment (waterfall) ─────────────────────────────
DERRICK_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
DROPCONTACT_API_KEY=
BETTERCONTACT_API_KEY=
NEVERBOUNCE_API_KEY=

# ─── PhantomBuster ────────────────────────────────────────────
PHANTOMBUSTER_API_KEY=

# ─── Posting ──────────────────────────────────────────────────
POSTIZ_API_URL=
POSTIZ_API_KEY=
LATE_API_KEY=
TYPEFULLY_API_KEY=

# ─── Agent Alex (Telegram alerts) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Agent Alex (extra platforms) ─────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_FROM_EMAIL=
WAVE_API_KEY=
WAALAXY_API_KEY=

# ─── App / Cloud Tasks ───────────────────────────────────────
APP_URL=https://facemedia.app
GCLOUD_PROJECT=face-media-factory
FUNCTION_REGION=europe-west1
